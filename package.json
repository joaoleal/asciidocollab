{
  "name": "asciidocollab",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test -- --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "architecture": "node scripts/ci/architecture-guard.mjs",
    "knip": "knip",
    "semgrep": "semgrep --config p/security-audit --config p/owasp-top-ten --config .semgrep.yml --error --quiet .",
    "audit": "pnpm audit --audit-level=high",
    "e2e:local": "scripts/ci/e2e-local.sh",
    "wasm": "scripts/ci/wasm.sh",
    "gate": "scripts/ci/gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.4",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-redos": "^4.5.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "knip": "^6.32.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
