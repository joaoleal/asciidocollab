{
  "name": "@asciidocollab/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:worker": "tsc --project src/workers/tsconfig.json",
    "build:asciidoctor-style": "node scripts/build-asciidoctor-style.mjs",
    "build:mathjax-style": "node scripts/build-mathjax-style.mjs",
    "build:mathjax-assets": "node scripts/build-mathjax-assets.mjs",
    "build:asciidoctor-pdf-wasm": "node scripts/build-asciidoctor-pdf-wasm.mjs",
    "build:harper-wasm": "node scripts/build-harper-wasm.mjs",
    "build:catalogue-fonts": "node scripts/build-catalogue-fonts.mjs",
    "build:woff2-wasm": "node scripts/build-woff2-wasm.mjs",
    "build:spellcheck-dictionary": "node scripts/build-spellcheck-dictionary.mjs",
    "build:html-export-css": "node scripts/build-html-export-css.mjs",
    "check:asciidoctor-style": "node scripts/build-asciidoctor-style.mjs --check",
    "check:html-export-css": "node scripts/build-html-export-css.mjs --check",
    "generate:print-highlight-css": "node scripts/build-print-highlight-css.mjs",
    "check:print-highlight-css": "node scripts/build-print-highlight-css.mjs --check",
    "generate:hljs-language-map": "node scripts/build-hljs-language-map.mjs",
    "check:hljs-language-map": "node scripts/build-hljs-language-map.mjs --check",
    "predev": "pnpm run build:worker && pnpm run build:asciidoctor-style && pnpm run build:mathjax-style && pnpm run build:mathjax-assets && pnpm run build:asciidoctor-pdf-wasm && pnpm run build:woff2-wasm && pnpm run build:catalogue-fonts && pnpm run build:pdfjs-worker && pnpm run build:spellcheck-dictionary && pnpm run build:harper-wasm && pnpm run build:html-export-css && lezer-generator src/lib/codemirror/asciidoc.grammar --output src/lib/codemirror/asciidoc-parser.js",
    "prebuild": "pnpm run build:worker && pnpm run build:asciidoctor-style && pnpm run build:mathjax-style && pnpm run build:mathjax-assets && pnpm run build:asciidoctor-pdf-wasm && pnpm run build:woff2-wasm && pnpm run build:catalogue-fonts && pnpm run build:pdfjs-worker && pnpm run build:spellcheck-dictionary && pnpm run build:harper-wasm && pnpm run build:html-export-css && lezer-generator src/lib/codemirror/asciidoc.grammar --output src/lib/codemirror/asciidoc-parser.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/ tests/ e2e/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eslint.json",
    "test": "jest",
    "test:ci": "jest --coverage --coverageReporters=text lcov",
    "check": "tsc --noEmit && eslint src/ tests/ e2e/ && jest",
    "e2e": "playwright test",
    "pdf-parity": "playwright test --config playwright.pdf-parity.config.ts",
    "render-equivalence": "playwright test --config playwright.render-equivalence.config.ts",
    "render-equivalence:capture": "CAPTURE_PREVIOUS_ENGINE=1 playwright test capture-previous-engine --config playwright.render-equivalence.config.ts",
    "render-equivalence:reference": "playwright test web-format-reference --config playwright.render-equivalence.config.ts",
    "render-equivalence:regression": "playwright test web-format-equivalence --config playwright.render-equivalence.config.ts",
    "render-equivalence:cross-format": "playwright test cross-format-agreement --config playwright.render-equivalence.config.ts",
    "mutate": "stryker run",
    "build:pdfjs-worker": "node scripts/build-pdfjs-worker.mjs"
  },
  "dependencies": {
    "@asciidocollab/asciidoc-core": "workspace:*",
    "@asciidocollab/asciidoc-pdf": "workspace:*",
    "@asciidocollab/primitives": "workspace:*",
    "@asciidocollab/shared": "workspace:*",
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0",
    "@hocuspocus/provider": "^4.5.0",
    "@hpcc-js/wasm": "^2.35.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@replit/codemirror-minimap": "^0.5.2",
    "asciidoctor": "4.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-lang-mermaid": "^0.5.0",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-tr": "^2.0.0",
    "dictionary-uk": "^4.0.0",
    "dompurify": "^3.4.13",
    "fflate": "0.8.3",
    "fonteditor-core": "^2.6.3",
    "harper.js": "2.7.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.30.0",
    "mathjax": "^4.1.3",
    "mermaid": "^11.16.1",
    "morphdom": "^2.7.8",
    "next": "16.3.0",
    "nspell": "^2.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.0",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@napi-rs/canvas": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "pdfjs-dist": "^6.2.108",
    "pixelmatch": "^7.2.0",
    "postcss": "^8.5.26",
    "postcss-prefix-selector": "^2.1.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
