# Reference-build toolchain for the web-formatted (HTML) preview's fidelity oracle.
#
# This is the canonical, external Asciidoctor — never the in-app JS engine. The gate that uses it
# asks "is the preview RIGHT?", and an oracle that resolves to a different version on a different
# machine cannot answer that: it would report the difference between two Asciidoctors as a defect in
# the app. Everything that could drift is therefore pinned, using the same four mechanisms the
# page-format toolchain already uses:
#
#   1. THE BASE IMAGE, BY DIGEST. `ruby:3.3` is a moving tag. The same digest the page-format
#      reference image pins is reused here, so the two oracles share one known-good base rather than
#      each acquiring a Ruby of its own.
#   2. THE GEM CLOSURE, BY LOCKFILE, installed `--frozen` so a lock disagreeing with the Gemfile
#      fails the BUILD instead of quietly re-resolving into a plausible-looking reference.
#   3. LOCALE AND TIME ZONE, set here rather than inherited from whoever runs the build.
#   4. THE CONVERSION SCRIPT. `reference-render.rb` decides the load options and the attributes, so
#      it belongs to the toolchain's identity: it is baked in and hashed into the image tag along
#      with the Gemfile and the lock (see `pdf-parity/tools/reference-image.mjs`). An image built
#      from an older script can never be silently reused.
#
# Separate from the page-format definition set ON PURPOSE — see the Gemfile beside this file.
#
# Bump deliberately, together with the `asciidoctor` npm package, and re-run the gate in the same
# commit.
FROM ruby@sha256:8d62d05359e370f55c2710645c976d7f04c9f5811378c7acc340ff416986da1e

ENV BUNDLE_GEMFILE=/gems/Gemfile \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC

WORKDIR /gems
COPY Gemfile Gemfile.lock ./
# World-readable so the image still works when run with `--user <host uid>`, which is how the gate
# invokes it: the host UID owns nothing inside the image, and without this the gems it needs to read
# would be unreachable.
RUN bundle install --frozen \
  && chmod -R a+rX /usr/local/bundle

COPY reference-render.rb /toolchain/reference-render.rb

# NEVER root. The conversion only reads the assembled sources and writes HTML beside them, and as
# root every generated file would land in the developer's checkout owned by root.
USER 1000:1000
