// AsciiDoc Lezer Grammar — FR-ED-002 token subset
// Block-level detection is handled by the external blockTokenizer (line-start aware).
// Inline markup is handled by the regular @tokens section.
@top Document { block* }

@skip {}

// Document-header position (before the title / after it / after the author line / past the header).
// The byline is positional, but the position CANNOT be a grammar sequence: Asciidoctor allows
// attribute entries and comment lines between the title, the author line and the revision line, and
// spelling those runs out makes `AttributeEntry` ambiguous between header metadata and the next block
// (a shift/reduce conflict lezer rejects). The tracker states the position directly, which also lets
// it tell THE document title from a level-0 title appearing mid-document.
@context blockContext from "./asciidoc-block-context"

@external tokens blockTokenizer from "./asciidoc-block-tokens" {
  docTitleToken,
  heading1Token, heading2Token, heading3Token, heading4Token, heading5Token,
  attrEntryToken,
  commentBlockDelim, commentLineToken,
  admonitionLineToken,
  admonNoteLineToken, admonTipLineToken, admonWarningLineToken, admonImportantLineToken, admonCautionLineToken,
  admonNoteAttrToken, admonTipAttrToken, admonWarningAttrToken, admonImportantAttrToken, admonCautionAttrToken,
  blockMacroToken,
  descListToken,
  listingDelim, literalDelim, exampleDelim, sidebarDelim, quoteDelim, passthroughDelim, openDelim, tableDelim,
  csvTableDelim, dsvTableDelim,
  stemAttrToken, admonAttrToken,
  diagramDeclToken,
  conditionalToken, blockAttrToken,
  checkDoneMarker, checkTodoMarker, unorderedMarker, orderedMarker,
  inlineMacroToken, footnoteToken,
  blockTitleToken,
  thematicBreakToken, pageBreakToken,
  hardBreakToken,
  continuationLineToken,
  paragraphLineToken,
  boldMarkToken, italicMarkToken, monoMarkToken,
  blockColsToken,
  authorLineToken, revisionLineToken,
  blankLineToken
}

block {
  // Document header. The implicit author line and the revision line are metadata ONLY in the header,
  // but that position is tracked by `@context` above (see it for why a grammar sequence cannot express
  // it), so here they are plain block alternatives the tokenizer emits only where the context allows.
  DocumentTitle | AuthorLine | RevisionLine |
  Heading5 | Heading4 | Heading3 | Heading2 | Heading1 |
  AttributeEntry |
  CommentBlock |
  CommentLine |
  StemBlock |
  ListingBlock |
  LiteralBlock |
  ExampleBlock |
  SidebarBlock |
  QuoteBlock |
  PassthroughBlock |
  OpenBlock |
  AdmonitionNoteBlock | AdmonitionTipBlock | AdmonitionWarningBlock | AdmonitionImportantBlock | AdmonitionCautionBlock |
  AdmonitionBlock |
  TableBlock |
  CsvTableBlock |
  DsvTableBlock |
  Conditional |
  TableCols |
  DiagramBlockDeclaration |
  BlockAttributeLine |
  ThematicBreak |
  PageBreak |
  BlockTitle |
  BlockMacro |
  CheckDoneItem | CheckTodoItem |
  UnorderedListItem |
  OrderedListItem |
  DescriptionList |
  AdmonitionNoteParagraph | AdmonitionTipParagraph | AdmonitionWarningParagraph | AdmonitionImportantParagraph | AdmonitionCautionParagraph |
  AdmonitionParagraph |
  blankLine |
  Paragraph
}

// ── Single-line block constructs ──────────────────────────────────────────────
DocumentTitle     { docTitleToken }
Heading1          { heading1Token }
Heading2          { heading2Token }
Heading3          { heading3Token }
Heading4          { heading4Token }
Heading5          { heading5Token }
AttributeEntry    { attrEntryToken }
CommentLine       { commentLineToken }
// Legacy fallback: `admonitionLineToken` is never emitted (per-severity tokens handle all valid
// label prefixes). This rule is unreachable at runtime but kept so the token declaration compiles.
AdmonitionParagraph { admonitionLineToken AdmonitionContinuation* }
AdmonitionContinuation { paragraphLineToken }
AdmonitionNoteParagraph      { AdmonNotePfx      inlineContent? nl AdmonitionContinuation* }
AdmonitionTipParagraph       { AdmonTipPfx       inlineContent? nl AdmonitionContinuation* }
AdmonitionWarningParagraph   { AdmonWarningPfx   inlineContent? nl AdmonitionContinuation* }
AdmonitionImportantParagraph { AdmonImportantPfx inlineContent? nl AdmonitionContinuation* }
AdmonitionCautionParagraph   { AdmonCautionPfx   inlineContent? nl AdmonitionContinuation* }
BlockMacro        { blockMacroToken }
// A description-list entry. The external tokenizer emits `descListToken` for ONLY the term plus its
// `::`/`;;` separator (not the rest of the line), so any definition on the same line is parsed as
// `inlineContent` and reads as body text — keeping it the same colour as a wrapped continuation line.
DescriptionList   { DescTerm inlineContent? nl DescriptionContinuation* }
DescTerm          { descListToken }
BlockTitle        { blockTitleToken }
Conditional       { conditionalToken }
// A table column-format specifier line `[cols="1,>2"]` (FR-046). The external tokenizer recognises a
// `[cols=…]` block-attribute line specifically and emits `blockColsToken` (whole line) so the cols
// specifier highlights distinctly from a generic `[source,ruby]` block-attribute line.
TableCols          { blockColsToken }
// A diagram block declaration line `[mermaid]` / `[graphviz]` / `[vega]` / `[vegalite]` sitting
// IMMEDIATELY above a delimited-block delimiter (`----` / `....`). The external tokenizer emits
// `diagramDeclToken` for the whole `[...]` line (only for a recognised notation with a following
// delimiter) so it highlights distinctly from a generic `[source,ruby]` block-attribute line.
DiagramBlockDeclaration { diagramDeclToken }
BlockAttributeLine { blockAttrToken }
ThematicBreak     { thematicBreakToken }
PageBreak         { pageBreakToken }

// ── List items ────────────────────────────────────────────────────────────────
// A list item's / description entry's principal text may wrap onto following non-blank
// lines (no blank line between). Those lines carry no block marker, so the external
// tokenizer emits a continuationLineToken for them only when the parser is positioned to
// attach one (Stack.canShift) — keeping plain paragraphs unaffected. Continuation nodes
// are tagged separately per parent (list vs description) so each inherits the matching
// highlight colour: highlightTree does not propagate a parent node's tag to child nodes.
// Principal text is OPTIONAL: an empty marker line (`. ` / `* ` with nothing after) is still a list
// item, and a glued following line is its principal-text continuation — so an empty item never breaks
// the list (it would otherwise error-recover and drop the rest of the list to a paragraph).
UnorderedListItem { UnorderedMark inlineContent? nl Continuation* }
OrderedListItem   { OrderedMark   inlineContent? nl Continuation* }
Continuation            { continuationLineToken }
DescriptionContinuation { continuationLineToken }

// ── Delimited blocks ──────────────────────────────────────────────────────────
ListingBlock     { ListingFence     blockBody ListingFence }
LiteralBlock     { LiteralFence     blockBody LiteralFence }
ExampleBlock     { ExampleFence     blockBody ExampleFence }
SidebarBlock     { SidebarFence     blockBody SidebarFence }
QuoteBlock       { QuoteFence       blockBody QuoteFence }
PassthroughBlock { PassthroughFence blockBody PassthroughFence }
OpenBlock        { OpenFence        blockBody OpenFence }
CommentBlock     { commentBlockDelim blockBody commentBlockDelim }

StemBlock        { StemAnnotation   PassthroughFence blockBody PassthroughFence }
// Legacy fallback: `admonAttrToken` is never emitted (per-severity tokens handle all [NOTE]/[TIP]/…).
AdmonitionBlock  { AdmonAnnotation  ExampleFence     blockBody ExampleFence }

TableBlock       { TableFence tableBody TableFence }
CsvTableBlock    { CsvTableFence blockBody CsvTableFence }
DsvTableBlock    { DsvTableFence blockBody DsvTableFence }

// ── Named wrappers for highlight-system access ──────────────────────────────
// Lezer only exposes PascalCase grammar rules as named nodes in the parse tree;
// lowercase external tokens are anonymous leaves that cannot be individually
// targeted by styleTags.  These thin wrappers give the highlighter a handle
// on each token range without requiring a heavier grammar refactor.

// Block fence delimiters — shared across block types
ExampleFence     { exampleDelim }
SidebarFence     { sidebarDelim }
QuoteFence       { quoteDelim }
OpenFence        { openDelim }
ListingFence     { listingDelim }
LiteralFence     { literalDelim }
PassthroughFence { passthroughDelim }
CsvTableFence    { csvTableDelim }
DsvTableFence    { dsvTableDelim }
TableFence       { tableDelim }

// Block-attribute annotation lines ([stem], [NOTE], etc.)
StemAnnotation    { stemAttrToken }
AdmonAnnotation   { admonAttrToken }
AdmonNoteAnnotation      { admonNoteAttrToken }
AdmonTipAnnotation       { admonTipAttrToken }
AdmonWarningAnnotation   { admonWarningAttrToken }
AdmonImportantAnnotation { admonImportantAttrToken }
AdmonCautionAnnotation   { admonCautionAttrToken }

// Admonition paragraph label prefixes (inline form: NOTE: , TIP: , etc.)
AdmonNotePfx         { admonNoteLineToken }
AdmonTipPfx          { admonTipLineToken }
AdmonWarningPfx      { admonWarningLineToken }
AdmonImportantPfx    { admonImportantLineToken }
AdmonCautionPfx      { admonCautionLineToken }

// List item markers
UnorderedMark { unorderedMarker }
OrderedMark   { orderedMarker }
CheckDoneMark { checkDoneMarker }
CheckTodoMark { checkTodoMarker }

AdmonitionNoteBlock      { AdmonNoteAnnotation      ExampleFence blockBody ExampleFence }
AdmonitionTipBlock       { AdmonTipAnnotation       ExampleFence blockBody ExampleFence }
AdmonitionWarningBlock   { AdmonWarningAnnotation   ExampleFence blockBody ExampleFence }
AdmonitionImportantBlock { AdmonImportantAnnotation ExampleFence blockBody ExampleFence }
AdmonitionCautionBlock   { AdmonCautionAnnotation   ExampleFence blockBody ExampleFence }

CheckDoneItem  { CheckDoneMark inlineContent? nl Continuation* }
CheckTodoItem  { CheckTodoMark inlineContent? nl Continuation* }

AuthorLine   { authorLineToken }
RevisionLine { revisionLineToken }

blockBody   { bodyLine* }
bodyLine    { rawBodyLine | blankLine }

tableBody   { (tableRow | blankLine)* }
tableRow    { TableCellMark inlineContent nl }
// Named wrapper so the leading `|` cell separator carries the muted markup colour (FR-046). Only the
// row-leading pipe is modelled here; any further `|` on the line falls into inlineContent.
TableCellMark { tableCellMark }

// A blank line is a bare newline OR a whitespace-only line (the external tokenizer emits
// `blankLineToken` for spaces/tabs followed by a newline) — both separate blocks in AsciiDoc.
blankLine   { nl | blankLineToken }

// ── Paragraphs with inline markup ─────────────────────────────────────────────
// A paragraph runs until a blank line: every following non-blank line is consumed as a
// continuation, even if it looks like a heading or list marker (Asciidoctor only recognises
// block constructs at a block boundary). The external tokenizer emits paragraphLineToken for
// those lines, so the markers never start a new block mid-paragraph.
Paragraph             { inlineContent nl ParagraphContinuation* }
ParagraphContinuation { paragraphLineToken }
inlineContent { inline+ }

// CONSTRAINED-FORMATTING NOTE: Bold / Italic / Monospace are now boundary-aware (US12/FR-044) —
// emitted as a single span token by the external tokenizer, which applies AsciiDoc's
// constrained/unconstrained word-boundary rule using lookbehind, so `a*b*c` / `2*3*4` are NOT
// bolded while genuine `*bold*` / `**bold**` are (SC-016). The OTHER shape-only inline constructs
// below still match by SHAPE and do not enforce the rule (`a+b+c`→Passthrough, `a&b;`→Entity), an
// accepted highlighter tradeoff for those marks; `Vec<3>` no longer falsely bolds and its `<3>`
// matches only the Callout shape, never an xref (`<<` requires a following id char).
inline {
  Bold | Italic | Monospace | Highlight | Subscript | Superscript |
  RoleSpan |
  InlineSet | AttributeReference | CrossReference | Footnote | InlineMacro |
  Passthrough | BiblioAnchor | InlineAnchor | Replacement | Entity | Callout |
  UiMacro | InlineStem | Link | SmartQuote | HardBreak |
  inlineWord | spaceTok | punctFallback | ltFallback | quoteFallback | markFallback
}

// Bold/Italic/Monospace are emitted as a SINGLE boundary-checked external token spanning the whole
// `*…*` / `**…**` (etc.) run — the constrained/unconstrained word-boundary rule (FR-044; SC-016)
// needs lookbehind the `@tokens` DFA cannot express, so the external tokenizer (which sees the
// preceding char) decides whether a mark opens a span at all. An in-word mark (`a*b*c`, `2*3*4`)
// emits no token and falls through to plain text. The whole span is one token (no inner nesting),
// trading nested-construct highlighting for boundary correctness — the chosen tradeoff per SC-016.
Bold       { boldMarkToken }
Italic     { italicMarkToken }
Monospace  { monoMarkToken }
Highlight  { hashMark         innerContent hashMark }
Subscript  { tildeMark        innerContent tildeMark }
Superscript { caretMark       innerContent caretMark }

// Role-based inline span `[.role]#text#` (constrained) or `[.role]##text##` (unconstrained) (US14,
// FR-021b). One self-contained token so the leading `[` never leaks to `punctFallback`. EVERY role
// span is tokenised the same way and highlighted generically; the inline-style registry adds a
// DISTINCT emphasis for KNOWN roles via a decoration (asciidoc-highlight-tags maps the generic tag).
RoleSpan   { roleSpanMark }

innerContent { (inlineWord | spaceTok | punctFallback | ltFallback | quoteFallback | markFallback)+ }

// Inline attribute assignment `{set:name:value}` / `{set:name!}` (FR-040/FR-042). Highlighted as an
// attribute construct (same tag as a `{name}` reference). Distinct token so it wins over a `{`-started
// reference; the `set:` literal makes the discrimination unambiguous.
InlineSet          { inlineSet }
AttributeReference { attrRef }
// A cross-reference `<<target>>` or `<<target,label>>`. The target id and the optional display
// label are distinct sub-nodes (FR-045) so the theme can colour them differently (target = link,
// label = body text). The interior tokens come from the scoped `@local tokens` group (below the main
// `@tokens` block): `xrefChunkChars` is the target (first chunk) or label (after the `,` separator).
// `XrefTarget` is OPTIONAL because `xrefOpen` already consumed the target's first character as its
// guard (see `xrefOpen`): a single-character target like `<<x>>` therefore leaves nothing for the
// target chunk to match. Requiring it made that xref fail to parse, so the node stopped at `<<x` and
// the trailing `>>` leaked out as ordinary prose (reaching the spell/grammar checker as markup).
CrossReference     { xrefOpen XrefTarget? (xrefSep XrefLabel)? xrefClose }
XrefTarget         { xrefChunkChars }
XrefLabel          { xrefChunkChars }
// The external tokenizer only fires at line start, so footnotes / inline macros that appear
// MID-line are recognised by the `@token` alternatives below (FR-026/052). At line start the
// external token wins (it runs first); mid-line it declines and the `@token` matches — both
// produce the same node, so highlighting is identical wherever the construct appears.
Footnote           { footnoteToken | footnoteMark }
InlineMacro        { inlineMacroToken | inlineMacroMark }

// Inline constructs gated by dedicated higher-priority tokens (T019 / grammar-tokens.md).
// Each only matches its full shape; an unmatched lone starter char falls through to
// `punctFallback` / `ltFallback` so ordinary prose (arithmetic, parentheses, `Q&A`,
// comparisons) still tokenizes without parser errors.
Passthrough   { passMark }
InlineAnchor  { anchorMark }
BiblioAnchor  { biblioMark }
Replacement   { replacementMark }
Entity        { entityMark }
Callout       { calloutMark }
UiMacro       { uiMacroMark }
InlineStem    { stemMark }
Link          { bareUrl }
SmartQuote    { smartDoubleQuote | smartSingleQuote }
// Trailing " +" before a line end. Emitted by the external tokenizer (it needs the
// preceding-space + following-newline lookahead that `@tokens` cannot express).
HardBreak     { hardBreakToken }

@tokens {
  // UI/math macros share a letter prefix with `inlineWord`, so the DFA needs an explicit
  // order. Precedence only applies when the macro token actually matches its full `name:[…]`
  // shape; a plain word that merely starts with the same letters still falls to `inlineWord`.
  @precedence { inlineSet, attrRef, footnoteMark, stemMark, uiMacroMark, inlineMacroMark, bareUrl, inlineWord }

  // Raw body line — any non-empty line inside delimited blocks
  rawBodyLine { ![\n]+ "\n" }

  // Table cell start (inline in table rows)
  tableCellMark { "|" }

  // Inline markup delimiters
  // A lone emphasis-mark char (`*`, `_`, backtick) that the external tokenizer did NOT consume as a
  // constrained/unconstrained span (FR-044). Kept as plain text so prose with an unpaired/in-word
  // mark (`a*b`, `f(x)_i`, `` a`b ``) still tokenizes without a parser error. The external span token
  // wins whenever a valid span exists (external tokens run before `@tokens`).
  markFallback     { $[*_`] }
  hashMark         { "#" }
  tildeMark        { "~" }
  caretMark        { "^" }

  // Role-based inline span `[.role]#text#` / `[.role]##text##` (FR-021b). The role attribute list is
  // one or more `.name` segments (`[.role1.role2]`); the body is `#…#` (constrained) or `##…##`
  // (unconstrained), forbidding a newline so an unterminated span never swallows following lines.
  // Spans its full shape so the leading `[.` never leaks a stray `[` into prose (it wins over the
  // `[` `punctFallback` by longest match).
  roleSpanMark {
    "[" ("." $[a-zA-Z0-9] $[a-zA-Z0-9_-]*)+ "]"
    ( "##" ![#\n]+ "##" | "#" ![#\n]+ "#" )
  }

  // Inline construct tokens
  attrRef { "{" $[a-zA-Z0-9_] $[a-zA-Z0-9_-]* "}" }
  // Inline attribute assignment `{set:name:value}` (set) or `{set:name!}` (unset). The `set:` literal
  // and the `!`/`:`-gated tail keep it from colliding with a plain `{name}` reference (which forbids
  // `:`). Wins over `attrRef` by the explicit precedence (both begin with `{`).
  inlineSet { "{set:" $[a-zA-Z0-9_] $[a-zA-Z0-9_-]* ("!" | ":" ![}\n]*) "}" }
  // Cross-reference opening delimiter (FR-045). The interior (target id, optional `,`-separated
  // label) and the closing `>>` are matched by a SCOPED `@local tokens` group below so the
  // comma/target/label tokens never leak into ordinary prose tokenization. The `<<` must be followed
  // by a non-space, non-`<`/`>` char so a bare `a << b` (space after) or a `<<<` page break stays
  // plain text via `ltFallback` rather than opening an xref that never closes (a parse error).
  xrefOpen        { "<<" ![ \t<>\n] }

  // Inline constructs (T019). Each is a single token spanning its full shape so a partial
  // match (e.g. a lone starter char) never leaks a stray sub-token into surrounding prose.
  // passMark's inner run forbids spaces so spaced arithmetic (`1 + 2`) is not a passthrough.
  passMark        { "+" ![+ \t\n]+ "+" }
  biblioMark      { "[[[" ![\]\n]+ "]]]" }
  anchorMark      { "[[" ![\]\n]+ "]]" }
  replacementMark { "(C)" | "(R)" | "(TM)" }
  entityMark      { "&" $[a-zA-Z0-9#]+ ";" }
  calloutMark     { "<" $[0-9]+ ">" }

  // Inline UI / math macros with an immediate `[` (kbd/btn, stem/latexmath/asciimath).
  // `inlineWord` stops at the `[`, so these always win by longest match (no precedence) and
  // never collide with the external inline-macro path (which skips an immediate `[`).
  uiMacroMark { ("kbd:" | "btn:") "[" ![\]\n]+ "]" }
  stemMark    { ("stem:" | "latexmath:" | "asciimath:") "[" ![\]\n]* "]" }

  // Bare auto-linked URL. The `://` scheme discriminator makes the `@precedence` over
  // `inlineWord` safe — a plain word that merely contains a colon never matches.
  bareUrl { ("https://" | "http://" | "ftp://" | "irc://") ![ \t\n\[\]<>]+ }

  // Generic mid-line inline macro `name:target[args]` (link/mailto/menu/xref/image/…). A SINGLE
  // colon after the name (the char after it is not `:`/`[`/space) keeps block macros (`name::`)
  // and the immediate-`[` UI/math macros out; it requires `[args]` so a plain `note:foo` stays text.
  inlineMacroMark { $[a-zA-Z] $[a-zA-Z0-9-]* ":" ![:\[ \t\n] ![\[\n]* "[" ![\]\n]* "]" }
  // Mid-line footnote `footnote:[…]`.
  footnoteMark { "footnote:[" ![\]\n]* "]" }

  // Smart typographic quotes — AsciiDoc curly-quote syntax `"`…`"` / `'`…`'` (a straight
  // quote immediately wrapping a backtick pair). Self-contained tokens, so they win over the
  // bare quote/backtick by longest match; a plain `"hello"` or apostrophe never matches.
  smartDoubleQuote { "\"`" ![`\n]+ "`\"" }
  smartSingleQuote { "'`" ![`\n]+ "`'" }

  // Lone narrowed-out starter chars that began no construct — kept as plain text so prose
  // tokenizes without parser errors (`1 + 2`, `f(x)`, `Q&A`, `a < b`, `[note]`, `don't`, `"x"`).
  punctFallback { $[+\[(&] }
  ltFallback    { "<" }
  quoteFallback { $["'] }

  // Generic inline word — excludes markup starters, whitespace, newlines
  inlineWord { ![\n *\t_`#~^{<\\+\[(&"']+ }
  spaceTok   { $[ \t]+ }

  nl { "\n" }
}

// Cross-reference interior token set (FR-045) — SCOPED to between `<<` and `>>` so the `,` separator
// and the target/label runs never affect ordinary prose tokenization (a global `,` token would be a
// disaster for prose). `xrefClose`/`xrefSep` end a chunk; `@else xrefChunkChars` is the run of any
// other non-delimiter chars that forms the target (first chunk) or the label (after the comma).
@local tokens {
  xrefClose { ">>" }
  xrefSep   { "," }
  @else xrefChunkChars
}
